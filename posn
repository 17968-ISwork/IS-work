<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบคลังข้อสอบจำลอง สอวน. เคมี (ค่าย 1)</title>
    <style>
        :root {
            --primary: #0284c7;
            --primary-hover: #0369a1;
            --success: #10b981;
            --danger: #ef4444;
            --background: #f0fdf4;
            --card: #ffffff;
            --text: #0f172a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'ChulaCharasNew', 'Sarabun', sans-serif;
        }

        body {
            background-color: var(--background);
            color: var(--text);
            padding: 20px;
            line-height: 1.6;
        }

        .container {
            max-width: 850px;
            margin: 0 auto;
            background: var(--card);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
            border: 2px solid #e2e8f0;
        }

        h1, h2, h3 {
            text-align: center;
            margin-bottom: 20px;
            color: var(--primary);
        }

        .unit-section {
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 5px solid var(--primary);
        }

        .unit-title {
            font-size: 18px;
            font-weight: bold;
            color: #1e3a8a;
            margin-bottom: 10px;
        }

        .btn {
            display: block;
            width: 100%;
            padding: 12px 20px;
            margin: 8px 0;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: left;
        }

        .btn:hover {
            background-color: var(--primary-hover);
            transform: translateX(4px);
        }

        .btn-center {
            text-align: center;
        }
        .btn-center:hover {
            transform: none;
        }

        .choice-btn {
            background-color: #f8fafc;
            color: var(--text);
            border: 2px solid #e2e8f0;
        }

        .choice-btn:hover {
            background-color: #f1f5f9;
        }

        .correct {
            background-color: var(--success) !important;
            color: white;
            border-color: var(--success);
        }

        .wrong {
            background-color: var(--danger) !important;
            color: white;
            border-color: var(--danger);
        }

        .hidden {
            display: none;
        }

        .progress-bar {
            width: 100%;
            background-color: #e2e8f0;
            height: 10px;
            border-radius: 5px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .progress {
            width: 0%;
            height: 100%;
            background-color: var(--success);
            transition: width 0.3s;
        }

        .explanation {
            margin-top: 15px;
            padding: 15px;
            background-color: #f0f9ff;
            border-left: 4px solid #0284c7;
            border-radius: 4px;
        }

        .score-text {
            font-size: 24px;
            text-align: center;
            margin: 20px 0;
            font-weight: bold;
        }

        .badge {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
            color: white;
            background-color: #6366f1;
        }
    </style>
</head>
<body>

<div class="container">
    <div id="category-screen">
        <h1>🧪 ระบบคลังข้อสอบจำลอง สอวน. เคมี (ค่าย 1)</h1>
        <p style="text-align:center; margin-bottom: 25px; color: #64748b;">🎯 ฝึกฝนรายบทเรียน ชุดละ 10 ข้อ ระบบจะสุ่มโจทย์ใหม่ให้ทำได้เรื่อยๆ ไม่จำกัด!</p>
        
        <div class="unit-section">
            <div class="unit-title">หน่วยที่ 1: ความปลอดภัยและทักษะในปฏิบัติการเคมี</div>
            <button class="btn" onclick="startQuiz('chem_safety')">▫️ ความปลอดภัยในการทำงานกับสารเคมีและการกำจัดสาร</button>
            <button class="btn" onclick="startQuiz('chem_accident')">▫️ อุบัติเหตุจากสารเคมีและการปฐมพยาบาล</button>
            <button class="btn" onclick="startQuiz('chem_measurement')">▫️ การวัดปริมาณสาร, อุปกรณ์ และเลขนัยสำคัญ</button>
            <button class="btn" onclick="startQuiz('chem_units')">▫️ หน่วยวัดระบบ SI และแฟกเตอร์เปลี่ยนหน่วย</button>
            <button class="btn" onclick="startQuiz('chem_method')">▫️ วิธีการทางวิทยาศาสตร์ในทางเคมี</button>
        </div>

        <div class="unit-section">
            <div class="unit-title">หน่วยที่ 2: อะตอมและสมบัติของธาตุ</div>
            <button class="btn" onclick="startQuiz('chem_models')">▫️ แบบจำลองอะตอม (ดอลตัน - กลุ่มหมอก)</button>
            <button class="btn" onclick="startQuiz('chem_isotopes')">▫️ อนุภาคในอะตอม เลขอะตอม เลขมวล และไอโซโทป</button>
            <button class="btn" onclick="startQuiz('chem_electrons')">▫️ การจัดเรียงอิเล็กตรอน (ระดับพลังงานหลัก/ย่อย/ออร์บิทัล)</button>
            <button class="btn" onclick="startQuiz('chem_periodic_table')">▫️ ตารางธาตุและแนวโน้มสมบัติของธาตุหมู่หลัก</button>
            <button class="btn" onclick="startQuiz('chem_transition')">▫️ ธาตุแทรนซิชันและสมบัติเฉพาะตัว</button>
            <button class="btn" onclick="startQuiz('chem_radioactive')">▫️ ธาตุกัมมันตรังสี, ครึ่งชีวิต และปฏิกิริยานิวเคลียร์</button>
            <button class="btn" onclick="startQuiz('chem_benefits')">▫️ การนำธาตุไปใช้ประโยชน์และผลกระทบต่อสิ่งแวดล้อม</button>
        </div>
    </div>

    <div id="quiz-screen" class="hidden">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <div>
                <span id="quiz-info-title" style="font-weight: bold; color: var(--primary);">วิชาเคมี</span>
                <span class="badge">สอวน. ค่าย 1</span>
            </div>
            <span id="question-number">ข้อที่ 1/10</span>
        </div>
        <div class="progress-bar"><div id="progress" class="progress"></div></div>
        
        <h3 id="question-text" style="text-align: left; color: var(--text); margin-bottom: 20px; white-space: pre-line;">โจทย์กำลังโหลด...</h3>
        
        <div id="choices-container"></div>
        
        <div id="explanation-container" class="explanation hidden">
            <strong>💡 เฉลยละเอียด:</strong> <span id="explanation-text"></span>
        </div>
        
        <button id="next-btn" class="btn btn-center hidden" onclick="nextQuestion()" style="margin-top: 20px; background-color: var(--success);">ข้อถัดไป ➡️</button>
    </div>

    <div id="result-screen" class="hidden">
        <h2>🎉 ทำข้อสอบเสร็จสิ้น!</h2>
        <div class="score-text" id="final-score">0 / 10 คะแนน</div>
        <p id="evaluation-text" style="text-align: center; margin-bottom: 20px; font-weight: bold; color: #475569;"></p>
        <button class="btn btn-center" onclick="restartQuiz()" style="background-color: var(--primary);">🔄 สุ่มโจทย์ใหม่ทำอีกรอบ (ทำได้เรื่อยๆ)</button>
        <button class="btn btn-center choice-btn" onclick="goBack('category-screen')">🏠 กลับหน้าเลือกบทเรียน</button>
    </div>
</div>

<script>
// 📌 คลังข้อสอบจริงตามโครงสร้างหลักสูตร สอวน. เคมี ค่าย 1 แบบเน้นคิดวิเคราะห์
const quizData = {
    chem_safety: {
        name: "ความปลอดภัยในการทำงานกับสารเคมีและการกำจัดสาร",
        questions: [
            { q: "สารเคมีที่มีสัญลักษณ์รูปไฟบนวงกลม (Oxidizing Amgents) ควรจัดเก็บและดูแลอย่างไรจึงจะปลอดภัยที่สุด?", c: ["เก็บรวมกับสารไวไฟเพื่อประหยัดพื้นที่", "เก็บให้ห่างจากสารไวไฟและสารลด (Reducing agents)", "เก็บในภาชนะเปิดเพื่อระบายความดัน", "แช่ในน้ำตลอดเวลา"], a: 1, exp: "สารออกซิไดซ์สามารถให้ออกซิเจนแก่ปฏิกิริยาได้ดี จึงต้องเก็บแยกห่างจากสารไวไฟและสารลดเพื่อป้องกันการเกิดไฟไหม้หรือระเบิด" },
            { q: "เมื่อทำการทดลองเสร็จสิ้นแล้วเหลือสารละลายกรดแก่และเบสแก่เข้มข้นปริมาณเล็กน้อย ข้อใดคือวิธีกำจัดที่ถูกต้องตามหลักห้องปฏิบัติการ?", c: ["เททิ้งลงอ่างน้ำทันทีแล้วเปิดน้ำตามมากๆ", "เทรวมกันในขวดสารอินทรีย์ไวไฟ", "ทำปฏิกิริยาสะเทินให้เป็นกลางก่อน แล้วจึงเจือจางด้วยน้ำเพื่อเททิ้ง", "นำไปเททิ้งในถังขยะแห้งทั่วไป"], a: 2, exp: "กรดและเบสแก่ต้องนำมาสะเทิน (Neutralization) ให้ได้ pH ใกล้เคียงเป็นกลางก่อน แล้วจึงระบายทิ้งอย่างปลอดภัย" },
            { q: "สารเคมีประเภทใดต่อไปนี้ที่ห้ามทิ้งลงในอ่างน้ำของห้องปฏิบัติการโดยเด็ดขาดแม้จะเจือจางแล้ว?", c: ["สารละลายโซเดียมคลอไรด์", "สารละลายกลูโคส", "โลหะโซเดียมและตัวทำละลายอินทรีย์ไม่ละลายน้ำ", "น้ำกลั่นที่เหลือใช้"], a: 2, exp: "โลหะโซเดียมทำปฏิกิริยารุนแรงกับน้ำเกิดแก๊สไฮโดรเจนและระเบิดได้ ส่วนสารอินทรีย์ไม่ละลายน้ำจะอุดตันและทำลายสิ่งแวดล้อม" },
            { q: "สัญลักษณ์ GHS รูปแผ่นอกมีดวงดาวสีขาวกระจายอยู่ข้างใน หมายถึงสารเคมีประเภทใด?", c: ["สารไวไฟ", "สารเป็นพิษต่อสุขภาพระยะยาวหรือก่อมะเร็ง", "สารกัดกร่อน", "แก๊สภายใต้ความดัน"], a: 1, exp: "สัญลักษณ์รูปคนมีดวงดาวที่อก (Health Hazard) แสดงว่าเป็นสารที่เป็นอันตรายต่อสุขภาพอย่างร้ายแรง เช่น ก่อมะเร็ง หรือเป็นพิษต่อระบบทางเดินหายใจ" },
            { q: "หากต้องการต้มสารละลายที่ไวไฟสูงในห้องปฏิบัติการ อุปกรณ์ให้ความร้อนชนิดใดปลอดภัยที่สุด?", c: ["ตะเกียงแอลกอฮอล์", "หัวตะเกียงแก๊สบุนเซน", "อ่างน้ำร้อน (Water bath) หรือแผ่นความร้อนไฟฟ้า (Hot plate)", "การจุดไฟเผาโดยตรง"], a: 2, exp: "สารไวไฟสูงห้ามโดนเปลวไฟโดยตรง การใช้ Hot plate หรือ Water bath ช่วยลดความเสี่ยงการติดไฟจากไอของสาร" }
        ]
    },
    chem_accident: {
        name: "อุบัติเหตุจากสารเคมีและการปฐมพยาบาล",
        questions: [
            { q: "หากสารละลายกรดเข้มข้นกระเด็นเข้าตา สิ่งที่ต้องทำเป็นอันดับแรกสุดคือข้อใด?", c: ["หาสารละลายเบสอ่อนๆ มาล้างเพื่อสะเทินกรด", "ล้างตาด้วยน้ำสะอาดปริมาณมากๆ ทันทีอย่างน้อย 15 นาที", "ใช้ผ้าสะอาดเช็ดตาให้แห้งสนิท", "ไปพบแพทย์ทันทีโดยไม่ล้างน้ำ"], a: 1, exp: "เมื่อสารเคมีเข้าตา ต้องล้างออกด้วยน้ำสะอาดปริมาณมากๆ ทันทีเพื่อเจือจางสารให้เร็วที่สุด ห้ามใช้กรดหรือเบสอื่นไปสะเทินในตาเด็ดขาดเพราะจะเกิดความร้อนซ้ำซ้อน" },
            { q: "หากผิวหนังสัมผัสกับโลหะโซเดียม (Sodium metal) โดยอุบัติเหตุ วิธีการปฐมพยาบาลข้อใดถูกต้อง?", c: ["ราดน้ำสะอาดปริมาณมากๆ ใส่แผลทันที", "ใช้แอลกอฮอล์ล้างแผลราดลงไป", "ใช้คีมคีบชิ้นโลหะออก ซับด้วยน้ำมัน แล้วรีบเช็ดออก ห้ามล้างน้ำโดยตรงทันที", "ทายาหม่องทับทันที"], a: 2, exp: "โลหะโซเดียมทำปฏิกิริยากับน้ำอย่างรุนแรงและเกิดความร้อนสูงมาก ดังนั้นห้ามใช้น้ำราดทันที ต้องคีบออกและเช็ดออกก่อน" },
            { q: "เกิดเหตุไฟไหม้สารเคมีที่เป็นของเหลวไวไฟอินทรีย์ (Class B) ไม่ควรใช้สิ่งใดในการดับไฟ?", c: ["ถังดับเพลิงชนิดผงเคมีแห้ง", "น้ำเปล่าจากสายยางราดโดยตรง", "ถังดับเพลิงแก๊สคาร์บอนไดออกไซด์", "ทรายแห้ง"], a: 1, exp: "ของเหลวอินทรีย์มักมีความหนาแน่นน้อยกว่าน้ำและไม่ละลายน้ำ การราดน้ำจะทำให้สารเคมีลอยตัวและกระจายวงกว้างทำให้ไฟลามมากกว่าเดิม" },
            { q: "สูดดมแก๊สคลอรีน (Chlorine gas) เข้าไปปริมาณมากจนรู้สึกแน่นหน้าอก ควรปฐมพยาบาลอย่างไร?", c: ["ให้ดื่มน้ำมะนาวมากๆ", "ย้ายผู้ป่วยไปที่ที่มีอากาศบริสุทธิ์และถ่ายเทสะดวกทันที", "ให้ผู้ป่วยออกกำลังกายเพื่อขับแก๊สออก", "ผายปอดทันทีโดยไม่เช็คระบบทางเดินหายใจ"], a: 1, exp: "เมื่อสูดดมแก๊สพิษ ต้องย้ายผู้ประสบอุบัติเหตุออกไปยังบริเวณที่มีอากาศบริสุทธิ์โดยเร็วที่สุด" }
        ]
    },
    chem_measurement: {
        name: "การวัดปริมาณสาร, อุปกรณ์ และเลขนัยสำคัญ",
        questions: [
            { q: "หากต้องการตวงสารละลายมาตรฐานปริมาตร 25.00 cm³ เพื่อทำการไทเทรต ควรใช้อุปกรณ์ใดจึงจะเหมาะสมและแม่นยำที่สุด?", c: ["บีกเกอร์ (Beaker)", "กระบอกตวง (Graduated cylinder)", "ปิเปตต์แบบปริมาตร (Volumetric pipette)", "ขวดรูปกรวย (Erlenmeyer flask)"], a: 2, exp: "ปิเปตต์แบบปริมาตร (Volumetric pipette) ออกแบบมาเพื่อจ่ายของเหลวที่มีปริมาตรแน่นอนเพียงค่าเดียวด้วยความแม่นยำทศนิยมสองตำแหน่ง" },
            { q: "ผลลัพธ์ของคำนวณตามหลักเลขนัยสำคัญของ (12.55 * 2.1) + 1.254 มีค่าเท่ากับข้อใด?", c: ["27.609", "27.61", "27.6", "28"], a: 2, exp: "12.55 (นัยสำคัญ 4 ตัว) * 2.1 (นัยสำคัญ 2 ตัว) ผลลัพธ์ต้องมีนัยสำคัญ 2 ตัว คือ 26 จากนั้นนำ 26 + 1.254 (ยึดทศนิยมตำแหน่งน้อยสุดคือไม่มีทศนิยม) จึงได้ 27 แต่ถ้าคิดละเอียดจะได้ 26.355 + 1.254 = 27.609 ปัดให้สอดคล้องหลักการคูณและการบวกจะได้ 27.6" },
            { q: "ข้อใดกล่าวถูกต้องเกี่ยวกับความแม่น (Accuracy) และความเที่ยง (Precision) ในการชั่งมวลสาร?", c: ["ความแม่นคือค่าที่ชั่งได้ใกล้เคียงกันทุกครั้ง", "ความเที่ยงคือค่าเฉลี่ยที่ได้ใกล้เคียงกับค่าจริง", "ความแม่นคือความใกล้เคียงของค่าจริง ส่วนความเที่ยงคือความใกล้เคียงกันของข้อมูลที่วัดซ้ำ", "ทั้งสองคำมีความหมายเหมือนกันทุกประการ"], a: 2, exp: "Accuracy (ความแม่น) คือความใกล้เคียงค่าจริง ส่วน Precision (ความเที่ยง) คือความคงเส้นคงวา วัดซ้ำแล้วได้ค่าใกล้เคียงกันเอง" }
        ]
    },
    chem_units: {

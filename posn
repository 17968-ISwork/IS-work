let currentQuestions = [];
let currentQuestionIndex = 0;
let score = 0;
let selectedPart = '';

function shuffle(array) {
    for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
}

function startQuiz(partKey) {
    selectedPart = partKey;
    document.getElementById('category-screen').classList.add('hidden');
    document.getElementById('quiz-screen').classList.remove('hidden');
    document.getElementById('quiz-info-title').innerText = quizData[partKey].name;
    
    const db = quizData[partKey].questions;
    
    // ระบบสุ่มโจทย์วนทำเรื่อยๆ: ก๊อปปี้คลังโจทย์มาสับไพ่สุ่ม
    let pool = JSON.parse(JSON.stringify(db));
    let finalSet = shuffle([...pool]);
    
    // หากข้อสอบในคลังมีน้อยกว่า 10 ข้อ ระบบจะสุ่มซ้ำให้ครบ 10 ข้อสร้าง Mock Exam เสมือนจริง
    while(finalSet.length < 10) {
        finalSet = finalSet.concat(shuffle([...pool]));
    }
    currentQuestions = finalSet.slice(0, 10);

    currentQuestionIndex = 0;
    score = 0;
    showQuestion();
}

function showQuestion() {
    document.getElementById('next-btn').classList.add('hidden');
    document.getElementById('explanation-container').classList.add('hidden');
    
    const qData = currentQuestions[currentQuestionIndex];
    document.getElementById('question-number').innerText = `ข้อที่ ${currentQuestionIndex + 1}/10`;
    
    const progressPercent = ((currentQuestionIndex) / 105) * 100; // คิดสัดส่วนแถบความคืบหน้า
    document.getElementById('progress').style.width = `${(currentQuestionIndex/10)*100}%`;

    document.getElementById('question-text').innerText = qData.q;
    
    const choicesContainer = document.getElementById('choices-container');
    choicesContainer.innerHTML = '';
    
    qData.c.forEach((choice, index) => {
        const button = document.createElement('button');
        button.className = 'btn choice-btn';
        button.innerText = `${index + 1}. ${choice}`;
        button.onclick = () => checkAnswer(index, button);
        choicesContainer.appendChild(button);
    });
}

function checkAnswer(selectedIndex, selectedButton) {
    const qData = currentQuestions[currentQuestionIndex];
    const choicesContainer = document.getElementById('choices-container');
    const buttons = choicesContainer.getElementsByClassName('choice-btn');
    
    for (let btn of buttons) {
        btn.disabled = true;
    }
    
    // แสดงผลเฉลย ถูก/ผิด ทันทีตามที่ต้องการ
    if (selectedIndex === qData.a) {
        selectedButton.classList.add('correct');
        score++;
    } else {
        selectedButton.classList.add('wrong');
        buttons[qData.a].classList.add('correct');
    }
    
    document.getElementById('explanation-text').innerText = qData.exp;
    document.getElementById('explanation-container').classList.remove('hidden');
    document.getElementById('next-btn').classList.remove('hidden');
}

function nextQuestion() {
    currentQuestionIndex++;
    if (currentQuestionIndex < 10) {
        showQuestion();
    } else {
        showResult();
    }
}

function showResult() {
    document.getElementById('quiz-screen').classList.add('hidden');
    document.getElementById('result-screen').classList.remove('hidden');
    
    document.getElementById('final-score').innerText = `${score} / 10 คะแนน`;
    
    let evalText = "";
    if(score >= 8) {
        evalText = "🏆 ยอดเยี่ยมระดับเหรียญทองสอวน.! ความรู้แม่นยำมาก ลุยทำบทอื่นต่อเลยจ้า";
    } else if(score >= 5) {
        evalText = "👍 ผ่านเกณฑ์พื้นฐานค่าย 1! ทบทวนจุดที่ผิดและกดสุ่มทำใหม่อีกรอบเพื่อความเป๊ะนะจ๊ะ";
    } else {
        evalText = "📖 พยายามอีกนิดน้า ข้อสอบสอวน. เน้นหลอกวิเคราะห์ ลองอ่านคำอธิบายด้านบนแล้วสุ่มลุยใหม่อีกรอบได้เลย!";
    }
    document.getElementById('evaluation-text').innerText = evalText;
}

function restartQuiz() {
    document.getElementById('result-screen').classList.add('hidden');
    startQuiz(selectedPart);
}

function goBack(screenId) {
    document.getElementById('quiz-screen').classList.add('hidden');
    document.getElementById('result-screen').classList.add('hidden');
    document.getElementById(screenId).classList.remove('hidden');
}
